# Copy this file to .env on the VPS. Never commit the real .env.

# LiveKit server connection (same room used by JRadio Studio)
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
LIVEKIT_ROOM=studio
RELAY_IDENTITY=jradio-azuracast-relay

# Only this named combined programme track is subscribed.
PROGRAM_TRACK_NAME=program

# AzuraCast DJ/live input details supplied by your hosting provider.
AZURACAST_HOST=YOUR_AZURACAST_HOST
AZURACAST_PORT=YOUR_DJ_INPUT_PORT
AZURACAST_MOUNT=/YOUR_MOUNT
AZURACAST_SOURCE_USERNAME=YOUR_DJ_INPUT_USERNAME
AZURACAST_SOURCE_PASSWORD=YOUR_DJ_INPUT_PASSWORD

# Keep the AzuraCast live input open during brief LiveKit track handoffs.
# After this many seconds without any programme track, release the input to AutoDJ.
SOURCE_LOSS_GRACE_SECONDS=120

# Output quality
OUTPUT_BITRATE=128k
LOG_LEVEL=INFO
